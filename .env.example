# Database
DATABASE_URL=postgresql://user:password@localhost:5432/skillforge

# Authentication
JWT_SECRET=your-secret-here-minimum-32-characters-use-crypto-randomBytes

# GitHub Integration (optional)
GITHUB_TOKEN=ghp_yourtoken

# Email (optional)
SENDGRID_API_KEY=SG.your_key
SENDGRID_FROM_EMAIL=no-reply@example.com

# Search (optional)
ALGOLIA_APP_ID=your_app_id
ALGOLIA_ADMIN_API_KEY=your_admin_api_key
ALGOLIA_INDEX_NAME=skillforge_users

# Environment
NODE_ENV=development
